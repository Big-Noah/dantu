#: src/class-tumblr-import.php:177
msgid "First, you will need to create an 'app' on Tumblr. The app provides a connection point between your blog and Tumblr's servers."
msgstr "First, you will need to create an 'app' on Tumblr. The app provides a connection point between your blog and Tumblr's servers."

#: src/class-tumblr-import.php:181
msgid "Click the large green \"Register Application\" button."
msgstr "Click the large green \"Register Application\" button."

#: src/class-tumblr-import.php:178
msgid "To create an app, visit this page:"
msgstr "To create an app, visit this page:"

#: src/class-tumblr-import.php:182
msgid "You need to fill in the \"Application Name\", \"Application Website\", and \"Default Callback URL\" fields. All the rest can be left blank."
msgstr "You need to fill in the \"Application Name\", \"Application Website\", and \"Default Callback URL\" fields. All the rest can be left blank."

#: src/class-tumblr-import.php:183
